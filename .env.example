# ============================================================
#  Copy this file to ".env" and fill in your own values.
#  NEVER commit your real .env file (it's in .gitignore).
# ============================================================

# --- Azure OpenAI (chat + embeddings) ---
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2023-05-15

# Deployment names you created in the Azure portal.
# These are referenced in app.py / the notebook.
AZURE_CHAT_DEPLOYMENT=your-chat-deployment-name
AZURE_EMBEDDING_DEPLOYMENT=your-embedding-deployment-name

# --- Airtable (optional: interaction + cost logging) ---
# Leave blank to disable logging.
AIRTABLE_API_TOKEN=your-airtable-personal-access-token
AIRTABLE_BASE_ID=your-airtable-base-id
AIRTABLE_TABLE_NAME=Legal_Juris_Log
